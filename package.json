{
  "name": "commentleak-scanner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "浏览器端注释敏感信息扫描器（零上传、零网络请求）",
  "engines": {
    "node": ">=18.18 <25"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@0.21.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs && node scripts/verify-no-network.mjs",
    "build:single": "tsc --noEmit && node scripts/build.mjs --single && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "verify:network": "node scripts/verify-no-network.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "fixtures:traversal": "node scripts/make-traversal-fixture.mjs",
    "fixtures:large": "node scripts/make-large-fixture.mjs",
    "fixtures:bomb": "node scripts/make-bomb-fixture.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",

    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.5"
  }
}
